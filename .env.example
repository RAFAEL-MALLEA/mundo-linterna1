# Copia este archivo como ".env" y ajusta los valores. NUNCA subas ".env" al repositorio.

# Clave secreta de Django (obligatoria si DJANGO_DEBUG=False).
# Genera una con:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# True solo en desarrollo.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Poner True cuando el sitio se sirva por HTTPS (activa cookies seguras, redirección SSL y HSTS).
DJANGO_HTTPS=False

# Webpay Plus (Transbank). Estas son las credenciales PÚBLICAS de integración (pruebas).
# Para producción: TRANSBANK_ENVIRONMENT=LIVE y tu código de comercio y API key reales.
TRANSBANK_ENVIRONMENT=TEST
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
